{
  "expo": {
    "name": "Movena",
    "slug": "physiovision-ai-mobile",
    "version": "0.29.0",
    "icon": "./assets/images/icon.png",
    "orientation": "portrait",
    "scheme": "movena",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.movena.mobile"
    },
    "android": {
      "package": "ai.movena.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#246BFD"
      }
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 210,
          "resizeMode": "contain",
          "backgroundColor": "#FAF8F3"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Movena to select a movement video for temporary analysis.",
          "cameraPermission": "Allow Movena to record a movement video for temporary analysis.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "releaseStatus": "external-beta-launch-candidate-no-go",
      "releaseCandidate": "0.29.0-rc.1",
      "router": {},
      "eas": {
        "projectId": "3161d775-09da-468e-b97d-f678ca583c4c"
      }
    }
  }
}
