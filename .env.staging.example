# Staging values are placeholders only. Copy into provider secret/environment settings; do not commit real values.
APP_ENV=staging
APP_VERSION=0.28.0
DATABASE_URL=
CORS_ALLOWED_ORIGINS=https://staging-web.example.invalid
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_UPLOAD_SIZE_MB=100
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.avi,.mkv,.webm
ARTIFACT_RETENTION_HOURS=24
ENABLE_SESSION_HISTORY=true
ENABLE_THERAPIST_DASHBOARD=true
ENABLE_ML_SECOND_OPINION=false
ENABLE_REPORT_GENERATION=true
ENABLE_OVERLAY_GENERATION=true
ENABLE_PUBLIC_DEMO_MODE=false
REQUIRE_AUTH_FOR_ANALYSIS=true
VITE_API_BASE_URL=https://staging-api.example.invalid
EXPO_PUBLIC_API_BASE_URL=https://staging-api.example.invalid
EXPO_PUBLIC_APP_ENV=staging
