# Safe local-development defaults. Do not place secrets in this file.
APP_ENV=development
APP_VERSION=0.12.0
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite:///./physiovision_dev.db
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_SIZE_MB=100
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.avi,.mkv,.webm
ARTIFACT_RETENTION_HOURS=24
POSE_BACKEND=mediapipe
POSE_TARGET_FPS=12
ENABLE_SUBJECT_CONTINUITY_GUARD=true
SUBJECT_MIN_VISIBILITY=0.5
SUBJECT_MAX_CENTROID_JUMP=0.16
SUBJECT_SEVERE_CENTROID_JUMP=0.24
SUBJECT_MAX_SCALE_RATIO=1.85
SUBJECT_SWITCH_EVENT_LIMIT=2
SUBJECT_MAX_TRACKING_GAP_FRAMES=10
ENABLE_SESSION_HISTORY=true
ENABLE_THERAPIST_DASHBOARD=true
ENABLE_ML_SECOND_OPINION=true
ENABLE_REPORT_GENERATION=true
ENABLE_OVERLAY_GENERATION=true
ENABLE_PUBLIC_DEMO_MODE=false
REQUIRE_AUTH_FOR_ANALYSIS=false
ACTIVE_SEQUENCE_RECOGNITION_MODEL_ID=exercise_pose_gru_20260809T161346Z
ACTIVE_FRAME_RECOGNITION_MODEL_ID=exercise_pose_xgb_20260809T154328Z
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256
FRONTEND_URL=http://localhost:5173
EMAIL_DELIVERY_MODE=console
EMAIL_FROM=no-reply@physiovision.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_VERIFICATION_EXPIRE_MINUTES=1440
PASSWORD_RESET_EXPIRE_MINUTES=30
AUTH_EMAIL_RESEND_COOLDOWN_SECONDS=60
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_FULL_NAME=Development Admin
SEED_SUPER_ADMIN_ON_START=false
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=change-me-to-a-unique-long-password
SUPER_ADMIN_FULL_NAME=Protected Super Administrator
ENABLE_TELEMEDICINE=false
DAILY_API_KEY=
DAILY_DOMAIN=
ENABLE_PAYMENTS=false
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
CANCELLATION_WINDOW_HOURS=24
HIGH_PAIN_THRESHOLD=7
PAIN_INCREASE_THRESHOLD=3
