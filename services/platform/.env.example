MOVENA_ENV=development
MOVENA_LEGACY_API_URL=http://127.0.0.1:8000
# Identity stays legacy-owned until an operator explicitly enables the tested transition.
MOVENA_IDENTITY_MODE=legacy
MOVENA_FRONTEND_URL=http://localhost:3000
MOVENA_EMAIL_DELIVERY_MODE=console
# Account registration remains unavailable until all four approved policy values are configured.
# MOVENA_TERMS_VERSION=
# MOVENA_TERMS_URL=
# MOVENA_PRIVACY_VERSION=
# MOVENA_PRIVACY_URL=
# SMTP is required for transition identity outside development.
# MOVENA_EMAIL_FROM=
# MOVENA_SMTP_HOST=
# MOVENA_SMTP_PORT=587
# MOVENA_SMTP_USERNAME=
# MOVENA_SMTP_PASSWORD=
# MOVENA_SMTP_USE_TLS=true
MOVENA_ACCOUNT_ERASURE_DELAY_DAYS=30
# Configure the same random 32+ character secret on both services before transition mode.
# MOVENA_INTERNAL_ASSERTION_SECRET=
# Set only for the explicit ownership-transfer command, then remove it.
# MOVENA_IDENTITY_TRANSFER_CONFIRMATION=
MOVENA_ALLOWED_HOSTS=localhost,127.0.0.1
# Opt in to structured request outcomes; they omit URLs, identities and payloads.
MOVENA_OUTCOME_LOG_LEVEL=INFO
# For non-development deployments, configure these values.
# MOVENA_DJANGO_SECRET=
# MOVENA_DATABASE_URL=postgresql://user:password@host:5432/movena_platform
# MOVENA_REDIS_URL=redis://host:6379/0
# Required only when running the explicit protected seeding command.
# MOVENA_SUPER_ADMIN_EMAIL=
# MOVENA_SUPER_ADMIN_USERNAME=
# MOVENA_SUPER_ADMIN_FULL_NAME=
# MOVENA_SUPER_ADMIN_PASSWORD=
