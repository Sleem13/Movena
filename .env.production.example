# Production template only. Store real secrets in the hosting provider's secret manager.
APP_ENV=production
ENABLE_TELEMEDICINE=true
DAILY_API_KEY=replace-with-secret-manager-reference
DAILY_DOMAIN=your-clinic.daily.co
ENABLE_PAYMENTS=true
PAYMOB_API_KEY=replace-with-secret-manager-reference
PAYMOB_INTEGRATION_ID=replace-me
PAYMOB_IFRAME_ID=replace-me
PAYMOB_HMAC_SECRET=replace-with-secret-manager-reference
CANCELLATION_WINDOW_HOURS=24
HIGH_PAIN_THRESHOLD=7
PAIN_INCREASE_THRESHOLD=3
APP_VERSION=1.0.0
DATABASE_URL=
CORS_ALLOWED_ORIGINS=https://app.example.com
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_UPLOAD_SIZE_MB=100
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.avi,.mkv,.webm
ARTIFACT_RETENTION_HOURS=24
POSE_TARGET_FPS=12
ENABLE_SESSION_HISTORY=true
ENABLE_THERAPIST_DASHBOARD=true
ENABLE_ML_SECOND_OPINION=false
ENABLE_EXERCISE_RECOGNITION=false
ENABLE_REPORT_GENERATION=true
ENABLE_OVERLAY_GENERATION=true
ENABLE_PUBLIC_DEMO_MODE=false
REQUIRE_AUTH_FOR_ANALYSIS=true
SEED_ADMIN_ON_START=false
SEED_SUPER_ADMIN_ON_START=false
FRONTEND_URL=https://app.example.com
EMAIL_DELIVERY_MODE=smtp
EMAIL_FROM=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-secret-manager-value
SMTP_PASSWORD=replace-with-secret-manager-value
SMTP_USE_TLS=true
EMAIL_VERIFICATION_EXPIRE_MINUTES=1440
PASSWORD_RESET_EXPIRE_MINUTES=30
AUTH_EMAIL_RESEND_COOLDOWN_SECONDS=60
