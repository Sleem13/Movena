# AWS: replace your-application.cloudfront.net with Terraform application_url.
# Set these in the staging provider. Never commit populated secrets.
APP_ENV=staging
APP_VERSION=0.28.0
DATABASE_URL=
CORS_ALLOWED_ORIGINS=https://your-application.cloudfront.net
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_UPLOAD_SIZE_MB=100
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.avi,.mkv,.webm
ARTIFACT_RETENTION_HOURS=24
POSE_TARGET_FPS=12
ENABLE_SESSION_HISTORY=true
ENABLE_THERAPIST_DASHBOARD=true
ENABLE_ML_SECOND_OPINION=false
ENABLE_EXERCISE_RECOGNITION=true
ENABLE_REPORT_GENERATION=true
ENABLE_OVERLAY_GENERATION=true
ENABLE_PUBLIC_DEMO_MODE=false
REQUIRE_AUTH_FOR_ANALYSIS=true
SEED_ADMIN_ON_START=false
SEED_SUPER_ADMIN_ON_START=false
FRONTEND_URL=https://your-application.cloudfront.net
EMAIL_DELIVERY_MODE=smtp
EMAIL_FROM=no-reply@staging.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-secret-manager-value
SMTP_PASSWORD=replace-with-secret-manager-value
SMTP_USE_TLS=true
EMAIL_VERIFICATION_EXPIRE_MINUTES=1440
PASSWORD_RESET_EXPIRE_MINUTES=30
AUTH_EMAIL_RESEND_COOLDOWN_SECONDS=60
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-secret-manager-value
SUPER_ADMIN_FULL_NAME=Protected Super Administrator
# Clinical escalation details shown in RehabRL governance surfaces.
CLINICAL_ORGANIZATION_NAME=Example Rehabilitation Organization
CLINICAL_ESCALATION_CONTACT=
CLINICAL_ESCALATION_INSTRUCTION=Follow your organization's urgent or emergency referral pathway.
